IDD_DIALOG_SYSTEMSET DIALOGEX 0, 0, 394, 256
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,129,235,50,14
    LTEXT           "震动检测：shock 等于",IDC_STATIC,24,25,99,8
    EDITTEXT        IDC_EDIT_SHOCK,103,21,40,14,ES_AUTOHSCROLL
    LTEXT           "参考信号接收功率：rsrp 大于等于",IDC_STATIC,24,100,125,8
    EDITTEXT        IDC_EDIT_RSRP,146,97,67,14,ES_AUTOHSCROLL
    LTEXT           "入网状态：reg 等于",IDC_STATIC,24,44,96,8
    EDITTEXT        IDC_EDIT_REG,96,41,46,14,ES_AUTOHSCROLL
    LTEXT           "电池电压： v 范围",IDC_STATIC,212,24,68,8
    EDITTEXT        IDC_EDIT_VLOWER,281,21,40,14,ES_AUTOHSCROLL
    LTEXT           "-",IDC_STATIC,326,24,16,8
    EDITTEXT        IDC_EDIT_VUPPER,334,21,40,14,ES_AUTOHSCROLL
    LTEXT           "电池温度：t1 范围",IDC_STATIC,211,44,70,8
    EDITTEXT        IDC_EDIT_T1LOWER,281,41,40,14,ES_AUTOHSCROLL
    LTEXT           "-",IDC_STATIC,325,44,16,8
    EDITTEXT        IDC_EDIT_T1UPPER,333,41,40,14,ES_AUTOHSCROLL
    LTEXT           "传感器温度：t2 范围",IDC_STATIC,204,64,80,8
    EDITTEXT        IDC_EDIT_T2LOWER,281,61,40,14,ES_AUTOHSCROLL
    LTEXT           "-",IDC_STATIC,325,64,18,8
    EDITTEXT        IDC_EDIT_T2UPPER,333,61,40,14,ES_AUTOHSCROLL
    LTEXT           "外部电源检测：pwr 等于",IDC_STATIC,24,64,92,8
    EDITTEXT        IDC_EDIT_PWR,114,60,40,14,ES_AUTOHSCROLL
    LTEXT           "授星数量：sv 大于等于",IDC_STATIC,25,83,96,8
    EDITTEXT        IDC_EDIT_SV,114,79,40,14,ES_AUTOHSCROLL
    PUSHBUTTON      "取消",IDCANCEL,183,235,50,14
    LTEXT           "检测reg信息：",IDC_STATIC,23,146,77,8
    GROUPBOX        "检测参数设置",IDC_STATIC,7,7,380,121
    GROUPBOX        "检测参数开关",IDC_STATIC,7,129,380,48
    CONTROL         "是",IDC_RADIO_REGYES,"Button",BS_AUTORADIOBUTTON,77,146,24,10
    CONTROL         "否",IDC_RADIO_REGNO,"Button",BS_AUTORADIOBUTTON,102,146,24,10
    GROUPBOX        "其他设置",IDC_STATIC,7,187,380,29
    LTEXT           "检测时间：",IDC_STATIC,20,201,47,8
    EDITTEXT        IDC_EDIT_CHECK_TIME,67,198,51,14,ES_AUTOHSCROLL
    LTEXT           "秒  (从检测到开始信号开始计时)",IDC_STATIC,124,201,114,8
END

